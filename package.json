{
  "name": "@darkm3tter/repo-guard",
  "version": "0.1.0",
  "description": "Executable policy engine for coding agents: gate what touches your repo (paths, contents, commands), not just tool names. MCP server + CLI + hooks.",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "repo-guard": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "mcp",
    "guardrails",
    "security",
    "agents",
    "vibe-coding",
    "policy"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
